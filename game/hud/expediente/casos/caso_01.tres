[gd_resource type="Resource" script_class="InformeCaso" load_steps=3 format=3]

[ext_resource type="Script" path="res://hud/expediente/informe_caso.gd" id="1"]
[ext_resource type="Texture2D" uid="uid://klapybxjvwxt" path="res://hud/expediente/fotos/caso_01_embarcadero.png" id="2"]

[resource]
script = ExtResource("1")
titulo = "\"LA NOCHE DEL CIERVO DE LUZ\""
lugar = "Campamento Pino Lunar, orilla norte del Lago Espejo."
fecha = "Noche del 14 al 15 de agosto."
etiqueta_victima = "VÍCTIMA"
victima = "Porky, 26 años, cocinera y encargada de mantenimiento del campamento."
foto = ExtResource("2")
pie_foto = "Embarcadero · 23:47"
sello = "CONFIDENCIAL"
a_cargo = "Det. Caneloso"
estado = "ABIERTO"
examen = PackedStringArray("Golpe contundente en la nuca, hecho con un objeto largo y duro.", "Agua en los pulmones: estaba viva al caer al lago, así que el golpe la dejó inconsciente y murió ahogada.", "Hora estimada de la muerte: entre las 23:10 y las 23:30.")
hallazgo = "A las 23:47, Eriz encontró el cuerpo flotando boca abajo junto al embarcadero. El agua brillaba azul a su alrededor por un fenómeno de algas luminosas."
circunstancias = "El campamento cierra este año. Para despedirlo, se han reunido siete personas que vivieron aquí aquel verano de hace 10 años; algunos trabajan hoy en el campamento."
linea_tiempo = PackedStringArray("Fogata|Durante la fogata, Juan Carlos contaba la leyenda del Ciervo de Luz: un venado con la cornamenta encendida que arrastra al lago a quien lo sigue.", "23:00|A las 23:00 se apagó todo el campamento. Hubo bramidos en el bosque y varios testigos vieron una silueta con cornamenta entre los árboles.", "23:10–23:30|Hora estimada de la muerte.|!", "23:40|La luz volvió a las 23:40.", "23:47|Eriz encuentra el cuerpo junto al embarcadero.|!")
notas = PackedStringArray("En el sendero del lago había huellas de pezuña de gran tamaño.")
antecedente = "Hace exactamente 10 años, Paco, de 12 años, hermano menor de la víctima, murió ahogado en este mismo lago. Todos los presentes estaban en el campamento aquel verano: seis eran campistas y Tony, de 21 años, era monitor auxiliar y nieto del entonces director, Don Guillermo. El caso se cerró como accidente."
titulo_personas = "PERSONAS PRESENTES ESA NOCHE"
personas = PackedStringArray("Tony|31|Director del campamento|Monitor auxiliar, con 21 años; ayudaba a su abuelo a coordinar a los chicos", "Juan Carlos|24|Monitor y cuentacuentos|Campista, con 14 años; uno de los mejores amigos de Paco", "Miawrio|23|Inversor; negocia la compra del terreno para un hotel|Campista, con 13 años; el mejor amigo de Paco", "Eriz|23|Volvió al campamento por nostalgia|Campista, con 13 años", "Aya|26|Fotógrafa de naturaleza, invitada para la temporada|Campista, con 16 años", "Mimita|24|Enfermera del campamento|Campista, con 14 años")
etiqueta_pasado = "HACE 10 AÑOS"
objetivo = "Examinar el campamento y el lago, reunir pruebas e interrogar a los implicados para determinar quién mató a Porky."
