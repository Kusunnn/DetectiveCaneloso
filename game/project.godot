config_version=5

[application]

config/name="Detective Caneloso"
run/main_scene="res://Escenas/Menus/menu_inicio.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

